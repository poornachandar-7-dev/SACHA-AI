# SACHA V3 — environment configuration
# Copy this file to `.env` and fill in the keys you actually want to use.
# Providers without a key are simply not registered (OmniRouter auto-skips them).

# --- App / runtime -----------------------------------------------------
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# --- Provider API keys ---------------------------------------------------
# Leave empty to disable that cloud provider. "local" (Ollama) never needs a key.
NVIDIA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Default routing -------------------------------------------------------
DEFAULT_PROVIDER=local
FALLBACK_PROVIDER=local
LOCAL_MODEL=llama3
LOCAL_BASE_URL=http://localhost:11434

# --- Voice -------------------------------------------------------------
STT_ENGINE=faster_whisper
TTS_ENGINE=piper
WAKEWORD_PHRASE=hey sacha
WHISPER_MODEL_SIZE=base
PIPER_MODEL_PATH=data/models/en_US-lessac-medium.onnx
VOSK_MODEL_PATH=data/models/vosk-model-small-en-us-0.15
AUDIO_SAMPLE_RATE=16000

# --- Telegram bridge (optional) ----------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Data / paths --------------------------------------------------------
DATA_DIR=data